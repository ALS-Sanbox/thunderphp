# User-uploaded files live in this directory. Nothing here should ever be
# executed as a script, regardless of what extension it was saved with -
# this is defense-in-depth alongside the MIME-based extension validation in
# app/models/Request.php::upload_files().

<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(?i:php[0-9]?|phtml|phar|pht)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
